# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Env / secrets
.env
.env.*
!.env.example

# Tauri / Rust
src-tauri/target/
# The CLI staged for the installer (scripts/build-installer.mjs, INT-01 L5).
src-tauri/bin/
src-tauri/gen/

# Local machine-specific cargo config (space-free target-dir override). The
# shared src-tauri/.cargo/config.toml (ts-rs export settings) is tracked.
/.cargo/

# Test / coverage
coverage/

# E2E: downloaded msedgedriver, JUnit results and app logs of the last run
e2e/.bin/
e2e/results/

# User manual (MAN-01): the PDF and its print sources are build output; the
# Markdown, images and pasos.json are committed.
docs/manual/.build/
docs/manual/*.pdf

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Blob store of a local API (SEC-04b, BLOB_DIR=data/blobs by default):
# attachments written by tours and dev runs, never committed.
server/data/
