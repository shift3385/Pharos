# Copy to .env and adjust. .env is git-ignored.

# ---- Postgres (used by docker-compose to create the container) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pharos_db

# ---- API ----
HOST=0.0.0.0
PORT=3000
# Docker: the db container is published on 5433 (default below).
# Native PostgreSQL: use its port instead (installer default 5432) and the
# password you chose for the postgres user — also in TEST_DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/pharos_db
# Development value only. With NODE_ENV=production the API refuses to start with
# it (or with any secret under 32 chars); generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-insecure-secret-change-me-please-min32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# "*" is refused in production: list the origins, e.g.
#   CORS_ORIGIN=https://pharos.example.com,http://tauri.localhost
CORS_ORIGIN=*
# Optional limits (README, "Production configuration"):
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW=1 minute
# BODY_LIMIT_BYTES=1048576
# SYNC_BODY_LIMIT_BYTES=8388608
# SYNC_TOMBSTONE_DAYS=30
# Behind a reverse proxy that ends TLS (SEC-07, docs/despliegue.md): true.
# The api service of docker-compose.yml already runs with it.
# TRUST_PROXY=false
# AI on the web with the desktop's key (IA-12, ADR-0034): 32 random bytes in
# base64, e.g. `openssl rand -base64 32`. Empty = off. Keep it out of the
# database backups: with both, the stored AI keys can be read.
# AI_VAULT_KEY=
# AI_CHAT_RATE_LIMIT_MAX=30
# AI_CHAT_RATE_LIMIT_WINDOW=1 minute
# AI_VAULT_RATE_LIMIT_MAX=10
# AI_VAULT_RATE_LIMIT_WINDOW=1 hour
# Public API /api/v1 (INT-02): requests per API token, or per IP without one.
# API_RATE_LIMIT_MAX=300
# API_RATE_LIMIT_WINDOW=1 minute
# Report uploads to /api/v1 (INT-02 A2): body as received, report decompressed,
# time to read it, uploads per token.
# API_UPLOAD_LIMIT_BYTES=26214400
# API_UPLOAD_MAX_BYTES=104857600
# API_PARSE_TIMEOUT_MS=30000
# API_UPLOAD_RATE_LIMIT_MAX=60
# API_UPLOAD_RATE_LIMIT_WINDOW=1 minute
# Webhooks (INT-03): key of the signing secrets (32 bytes in base64,
# `openssl rand -base64 32`; empty = off), private targets, allowed hosts.
# WEBHOOK_SECRETS_KEY=
# WEBHOOK_ALLOW_PRIVATE=false
# WEBHOOK_ALLOW_HOSTS=
# WEBHOOK_DISPATCH_INTERVAL_MS=2000
# API-token notices (INT-02): how often they are looked for (ms; 0 = never).
# TOKEN_NOTICE_INTERVAL_MS=3600000
# AI_CHAT_BODY_LIMIT_BYTES=20971520
# Password reset by email (SEC-09, ADR-0045). Optional and off by default:
# without SMTP_HOST the server sends no email and accounts recover with their
# recovery codes. With SMTP_HOST, SMTP_FROM and APP_PUBLIC_URL are required;
# APP_PUBLIC_URL is the web build's address (https; http only for localhost).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Pharos <no-reply@example.com>
# APP_PUBLIC_URL=https://pharos.example.com
# RESET_TOKEN_TTL=30 minutes
# Server administrators (SEC-11, ADR-0045): the first account registered is
# one; these emails are named at start-up and at sign-up (never removed). Use
# it to recover access if every administrator is lost.
# PHAROS_ADMINS=admin@example.com
# How long a reset link made by an administrator works (SEC-09).
# ADMIN_RESET_TTL=24 hours

# ---- docker compose: the caddy service (SEC-07) ----
# The name the team reaches the server by. A public domain gets a Let's
# Encrypt certificate; localhost or an internal name uses Caddy's own CA.
# PHAROS_DOMAIN=pharos.example.com

# ---- Tests ----
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/pharos_test_db
