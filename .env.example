# Copy to .env and adjust. .env is git-ignored.

# ---- Postgres (used by docker-compose to create the container) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pharos_db

# ---- API ----
HOST=0.0.0.0
PORT=3000
# Docker: the db container is published on 5433 (default below).
# Native PostgreSQL: use its port instead (installer default 5432) and the
# password you chose for the postgres user — also in TEST_DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/pharos_db
# Development value only. With NODE_ENV=production the API refuses to start with
# it (or with any secret under 32 chars); generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-insecure-secret-change-me-please-min32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# "*" is refused in production: list the origins, e.g.
#   CORS_ORIGIN=https://pharos.example.com,http://tauri.localhost
CORS_ORIGIN=*
# Optional limits (README, "Production configuration"):
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW=1 minute
# BODY_LIMIT_BYTES=1048576
# SYNC_BODY_LIMIT_BYTES=8388608
# SYNC_TOMBSTONE_DAYS=30
# TRUST_PROXY=false

# ---- Tests ----
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/pharos_test_db
