# Copy to .env and adjust. .env is git-ignored.

# ---- Postgres (used by docker-compose to create the container) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pharos_db

# ---- API ----
HOST=0.0.0.0
PORT=3000
# Docker: the db container is published on 5433 (default below).
# Native PostgreSQL: use its port instead (installer default 5432) and the
# password you chose for the postgres user — also in TEST_DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/pharos_db
# Use a long random value in production (min 32 chars):
JWT_ACCESS_SECRET=dev-insecure-secret-change-me-please-min32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=*

# ---- Tests ----
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/pharos_test_db
