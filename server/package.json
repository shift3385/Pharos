{
  "name": "pharos-server",
  "private": true,
  "version": "0.5.0-beta.1",
  "type": "module",
  "description": "Pharos backend — accounts, authentication and sync API.",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "node ../scripts/api-port.mjs free",
    "dev": "tsx watch src/server.ts",
    "prestart": "node ../scripts/api-port.mjs free",
    "start": "tsx src/server.ts",
    "build": "node scripts/build.mjs",
    "start:dist": "node dist/server.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:licenses": "node scripts/check-licenses.mjs",
    "seed:test-user": "tsx src/db/seed-test-user.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.1",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cucumber/messages": "^34.2.1",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12"
  }
}
