{
  "name": "pharos",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "Pharos — QA test management suite (desktop, offline-first).",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:installer": "node scripts/build-installer.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --coverage.include=src/** --coverage.reporter=text-summary --coverage.reporter=html --coverage.reporter=lcov --coverage.reporter=json-summary",
    "coverage:rust": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --no-report && cargo llvm-cov report --manifest-path src-tauri/Cargo.toml --summary-only && cargo llvm-cov report --manifest-path src-tauri/Cargo.toml --html --output-dir coverage/rust && cargo llvm-cov report --manifest-path src-tauri/Cargo.toml --lcov --output-path coverage/rust/lcov.info",
    "e2e": "node e2e/scripts/run-smoke.mjs",
    "e2e:driver": "node e2e/scripts/fetch-edgedriver.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:version": "node scripts/version.mjs check",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:changelog": "node scripts/changelog.mjs check",
    "changelog:preview": "node scripts/changelog.mjs preview",
    "changelog:collect": "node scripts/changelog.mjs collect",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "check:audit": "node scripts/audit-gate.mjs",
    "check:deps": "cd src-tauri && cargo deny --config ../deny.toml check",
    "check:rust": "node scripts/rust-gates.mjs fmt && node scripts/rust-gates.mjs clippy",
    "contracts": "node scripts/contracts.mjs generate",
    "check:contracts": "node scripts/contracts.mjs check",
    "version:set": "node scripts/version.mjs set",
    "verify:static": "npm run typecheck && npm run lint && npm run check:licenses && npm run check:version && npm run check:changelog && npm run check:migrations && npm run test:scripts",
    "verify": "npm run verify:static && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@tauri-apps/api": "^2.1.1",
    "exceljs": "^4.4.0",
    "i18next": "^23.16.8",
    "jszip": "^3.10.1",
    "lucide-react": "^1.65.0",
    "pdfmake": "^0.2.23",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router": "^7.18.5",
    "react-simple-code-editor": "^0.14.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@cucumber/tag-expressions": "^11.0.1",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/pdfmake": "^0.3.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/junit-reporter": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.16",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "webdriverio": "^10.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings 0"
  }
}
